<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for API 31+.
   SIP credentials (settings_prefs/auth_prefs) must not be backed up
   nor transferred to another device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="settings_prefs.xml"/>
        <exclude domain="sharedpref" path="auth_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="settings_prefs.xml"/>
        <exclude domain="sharedpref" path="auth_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
